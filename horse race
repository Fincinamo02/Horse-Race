import random

horse1_level = random.randint(1, 20)
horse2_level = random.randint(1, 20)
horse3_level = random.randint(1, 20)
horse4_level = random.randint(1, 20) 

horse1 = 0
horse2 = 0
horse3 = 0
horse4 = 0

